<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  namespace 必须写 Mapper 接口的全限定名。
  MyBatis 靠它把 XML 和接口绑定起来，然后按「标签 id == 接口方法名」配对。
  写错了启动就会报 Invalid bound statement (not found)。
-->
<mapper namespace="com.example.mall.mapper.ProductMapper">

    <!--
      ============================================================
       ★ 先说一个必须记住的安全点： #{} 和 ${} 的区别
      ============================================================

      #{}  生成的是 JDBC 的预编译占位符 ?，参数值走 setXxx() 设置。
           值永远被当成「数据」，不会被解析成 SQL 语法。
           → 安全，防 SQL 注入。99% 的情况都用这个。

      ${}  是直接把值拼进 SQL 字符串里。
           如果值是用户输入的，攻击者可以构造这样的输入：
              name = "1' OR '1'='1"
           拼出来就变成：
              WHERE name = '1' OR '1'='1'      ← 条件恒成立，全表数据泄露
           更狠的可以拼 DROP TABLE。
           → 极其危险，只用于「值本身就该是 SQL 片段」的场景，
             比如动态排序字段 ORDER BY ${sortField}。
             而且那种场景也必须在 Java 侧用白名单校验，不能直接用前端传来的值。

      本项目里除了动态排序，其他地方一律用 #{}。
    -->

    <!--
      通用查询条件片段。
      用 <sql> + <include> 抽出来，是因为列表查询和总数查询的 WHERE 条件
      必须完全一致（否则分页会错乱），抽成一份能保证它们不会写岔。
    -->
    <!--
      ==========================================================================
       ★ 里程碑 15：把 SKU 的聚合下推到一个【派生表】
      ==========================================================================

      价格和库存的唯一真源是 product_sku，「起售价 / 总库存 / 几个规格」
      都要从它身上算出来。写成下面这样一张派生表，而不是直接
      LEFT JOIN + GROUP BY，理由是：

        ★ 外层 SELECT / WHERE / ORDER BY 的形状一个字都不用动。
          queryCondition、shopOrderBy 这些共用片段原样保留 ——
          如果写成 JOIN + GROUP BY，ONLY_FULL_GROUP_BY（MySQL 8 的
          服务端默认值，本项目没有任何地方关掉它）会逼着每一个共用片段
          里的列都进 GROUP BY 或者套聚合函数，一处漏改就是启动后第一条
          查询就 500。派生表把这件事关在下面这六行里。

      ⚠️ 性能：这是「每查一次商品列表就把 product_sku 全表分组一遍」。
        100 件商品、每件几条 SKU 的规模下是一次可以忽略的全表扫。
        什么时候该翻案，见 migration-13b 脚本里的注释。

      ⚠️ COALESCE：一件商品如果【一条 SKU 都没有】，LEFT JOIN 会让
        min_price / total_stock / sku_count 全变成 NULL。
        这里只给后两个兜 0，因为「0 个规格」「总库存 0」是【真答案】。
        min_price 保持 NULL —— 空集合上的最小值没有答案，
        一个回答不了的问题不该有一个假答案（前端会显示成「—」）。

      ★★ 里程碑 15 阶段 3 补了 only_sku_id：单规格商品的「那唯一一个 SKU」。
        用户端首页的卡片靠它直接加购 —— 只有一件商品恰好一个规格时，
        「买这个商品」才等于「买这个 SKU」。
        ⚠️ 用它的时候【必须】同时判 sku_count = 1：
          MIN(id) 在多规格商品上会「随便挑一个」，而那不是答案。
          给不出答案的问题就该留空（所以外面套 CASE WHEN 而不是直接给）。

      ★★ 这个 join 是【有代价】的，加它之前先问一句「这条 SQL 还有谁在用」：
        MySQL 8.0.22 起有 derived condition pushdown，但它
        【只对不带聚合的派生表生效】—— 这里带 GROUP BY，
        所以 WHERE p.id = ? 这种条件【不会】被推进去，
        每次查询都要把整个 product_sku 分组一遍。

        这就是为什么 selectShopById（被「加入购物车」复用）【没有】加它：
        给那条 SQL 加等于让每次加购都多扫一遍 product_sku。
        它的 SKU 相关字段由 Service 事后单独查、在 Java 里算出来 ——
        做法和里程碑 11 的 images、里程碑 12 的 reviewSummary 一字不差。
        ★ 给一个查询加 join 的代价，不取决于这个 join 本身，
          而取决于【读它的那条 SQL 还有谁在用】。
    -->
    <sql id="skuAggregate">
        LEFT JOIN (
            SELECT product_id,
                   MIN(price) AS min_price,
                   SUM(stock) AS total_stock,
                   COUNT(*)   AS sku_count,
                   MIN(id)    AS only_sku_id
            FROM product_sku
            GROUP BY product_id
        ) a ON a.product_id = p.id
    </sql>

    <!--
      通用查询条件片段。
      用 <sql> + <include> 抽出来，是因为列表查询和总数查询的 WHERE 条件
      必须完全一致（否则分页会错乱），抽成一份能保证它们不会写岔。
    -->
    <sql id="queryCondition">
        <where>
            <!--
              <where> 标签的两个作用：
                1. 如果内部所有 <if> 都不成立，它不会生成 WHERE 关键字
                2. 会自动去掉开头多余的 AND/OR
              没有它的话，就得写 WHERE 1=1 这种凑数条件，很丑
            -->
            <if test="name != null">
                <!--
                  CONCAT('%', #{name}, '%') 拼成 LIKE '%手机%' 的模糊匹配。
                  注意 % 是写在 SQL 里的常量，不是拼进参数里的，
                  所以这里用 #{} 完全安全
                -->
                AND p.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
            <if test="status != null">
                AND p.status = #{status}
            </if>
        </where>
    </sql>

    <!--
      分页查询商品列表。

      resultType 用 ProductVO 而不是 Product，因为要装 join 出来的 category_name。
      application.yml 里开了 map-underscore-to-camel-case=true，
      所以 category_name 这一列会自动映射到 categoryName 字段，不用手写映射。
    -->
    <select id="selectPage" resultType="ProductVO">
        SELECT
            p.id,
            p.category_id,
            p.name,
            p.cover,
            p.description,
            p.status,
            p.create_time,
            p.update_time,
            c.name AS category_name,
            a.min_price                    AS min_price,
            COALESCE(a.total_stock, 0)     AS total_stock,
            COALESCE(a.sku_count, 0)       AS sku_count
        FROM product p
                 LEFT JOIN category c ON c.id = p.category_id
                 <include refid="skuAggregate"/>
        <include refid="queryCondition"/>
        ORDER BY p.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!--
      查总数。WHERE 条件用同一个 <include>，保证和列表查询永远一致。

      这里把 category 的 join 去掉了：总数只跟 product 的筛选条件有关，
      join 一张表纯粹是浪费。能少 join 就少 join，这是 SQL 性能的基本意识。
    -->
    <select id="countByQuery" resultType="long">
        SELECT COUNT(*)
        FROM product p
        <include refid="queryCondition"/>
    </select>

    <!--
      统计某个分类下的商品数量。

      注意这里不带上 status 条件 —— 下架的商品也是「挂在分类下」的，
      删了分类它们一样会变成孤儿数据。
      做这种统计时要先想清楚「算不算数」的边界：
      如果只统计上架商品，运营可能会遇到「显示 0 个商品，但删不掉」的困惑。
    -->
    <select id="countByCategoryId" resultType="long">
        SELECT COUNT(*)
        FROM product
        WHERE category_id = #{categoryId}
    </select>

    <!--
      查详情，要带分类名，所以 join。

      ★ 里程碑 11：resultType 从 ProductVO 改成了它的子类 AdminProductDetailVO。

        这里值得说清楚两件事：

        ① resultType 天然支持子类 —— MyBatis 按 setter 往对象里填值，
           子类继承了父类【全部】的 setter，所以下面这些列一个都不会漏。
           本方法的 SQL 因此【一个字都没改】。

        ② ⚠️ 但图集（images）不在上面这些列里，也【不在】这条 SQL 里查。
           它是 Service 查完商品之后单独查一次、set 进去的。
           原因见 ProductServiceImpl.getById 的 javadoc
           （一句话：selectShopById 被购物车复用了，
            不能往共用的查询里塞只给详情页用的东西）。

        ★ 为什么用继承的子类，而不是「查出 ProductVO 再手工 new 一个子类拷字段」？
          因为后者会造出【第二条转换路径】，而 OrderServiceImpl.toVO 的注释
          专门警告过：第二条路径就是将来加字段时漏掉一处的来源。
          现在仍然只有一条路径，只是它的产出类型变成了子类。
    -->
    <select id="selectById" resultType="AdminProductDetailVO">
        SELECT
            p.id,
            p.category_id,
            p.name,
            p.cover,
            p.description,
            p.status,
            p.create_time,
            p.update_time,
            c.name AS category_name,
            a.min_price                    AS min_price,
            COALESCE(a.total_stock, 0)     AS total_stock,
            COALESCE(a.sku_count, 0)       AS sku_count
        FROM product p
                 LEFT JOIN category c ON c.id = p.category_id
                 <include refid="skuAggregate"/>
        WHERE p.id = #{id}
    </select>

    <!--
      只查「规格定义」那一列。

      ★ 里程碑 15 为什么要单独一条 SQL，而不是把它并进 selectById？

        因为 selectById 的 resultType 是 AdminProductDetailVO，
        而那个类上的 specSchema 字段是 List<SpecGroup>（已经解析好的数组），
        不是 String。数据库里存的却是一段 VARCHAR 文本。
        MyBatis 按【字段类型】挑 TypeHandler，List 找不到对应的处理器，
        于是会退化成 rs.getObject() 再强转 —— 一个运行时的 ClassCastException。

        要绕过去只有两条路：给这一列写一个 resultMap + 自定义 TypeHandler
        （本项目【一个 resultMap 都没用过】，为了一个字段引入这套东西不划算），
        或者让 Service 把「解析」这一步显式做掉。这里选后者。

      ⚠️ 代价是管理端详情多一次只有一列的往返。这和图集的取舍是同一条：
        详情页本来就不频繁，多一次往返换「解析这件事看得见」是划算的
        （论证见 ProductServiceImpl.getById 的 javadoc）。

      ⚠️ 它留在 ProductMapper 而不是 ProductSkuMapper：规则是「谁的表谁负责查」，
        查的是 product 表。返回 null 表示这个 id 不存在 ——
        但调用方（getById）在这之前已经用 selectById 确认过存在了。
    -->
    <select id="selectSpecSchema" resultType="string">
        SELECT spec_schema
        FROM product
        WHERE id = #{id}
    </select>

    <!--
      ★ 里程碑 15 阶段 3：批量版，存在的唯一理由是【别写成 N+1】。

      用户端要渲染一批 SKU 的 specText，而那句话里维度的显示顺序
      来自各自商品的 spec_schema。逐个商品调上面那条就是
      「购物车里 10 件商品发 10 条 SQL」—— 和 selectShopByIds 的
      注释里写的是同一个道理：能一条 SQL 查完的绝不循环查。

      ⚠️ 只 SELECT 两列：id 和 spec_schema。
        它返回的 Product 是当【载体】用的，不是一个完整的实体 ——
        其余字段全是 null。这一点在 ProductMapper.selectSpecSchemasByProductIds
        的 javadoc 里也写了一遍，因为将来有人看到这个方法
        很可能会想「顺手把 name 也查出来吧」，然后它就不再是一个
        只有两列的窄查询了。

      ★ 注意这里【不带 status 条件】：
        调用方是「已经拿到了一批可买的 SKU，现在要渲染它们」，
        过滤在那一步已经做完了。在这里再过一遍 status
        只会让「商品刚下架」和「商品不存在」变成两种需要分别处理的缺失。
    -->
    <select id="selectSpecSchemasByProductIds" resultType="Product">
        SELECT id, spec_schema
        FROM product
        WHERE id IN
        <foreach collection="ids" item="pid" open="(" close=")" separator=",">
            #{pid}
        </foreach>
    </select>

    <!--
      查实体，不 join —— 写操作前的校验不需要分类名，少查一张表。

      参数是单个基本类型时，{@code #{id}} 里的名字其实随便写都行
      （MyBatis 会直接取那唯一的值），但为了可读性还是写成和参数名一致。
      如果方法有多个参数，就必须用 @Param 指定名字，否则只能用 param1/param2。
    -->
    <select id="selectEntityById" resultType="Product">
        SELECT id, category_id, name, cover, description, spec_schema, status, create_time, update_time
        FROM product
        WHERE id = #{id}
    </select>

    <!--
      新增商品。

      useGeneratedKeys="true" + keyProperty="id" 这两个属性配合起来，
      MyBatis 会把数据库生成的自增主键回填到入参对象的 id 字段上。
      所以 Service 里调用完 insert，product.getId() 立刻就有值了，
      不需要再发一条 SELECT 去查。

      ★★ 里程碑 15 阶段 6：price / stock 两列从这里消失了。

      这不是「少写两个字段」，而是这张表的职责变小了：
      **价格和库存的唯一真源是 product_sku，product 上不再有任何一份副本。**
      建商品 = 这张表插一行 + product_sku 插 N 行，两件事在同一个事务里
      （见 ProductServiceImpl.save），任何一半单独存在都是坏数据。

      ⚠️ 反过来说：如果哪天有人想把 price 加回这张表「方便查列表」，
        那就是**第二个写入者**回来了。库存在事务里被并发扣减
        （20 线程抢库存的测试就在 test-order.py 里），
        汇总副本一定漂移，而且漂移了没有任何一层会报错 ——
        里程碑 15 阶段 5 实测到过一条（商品 683：product.stock=29 /
        product_sku.stock=30，见 README）。删这一列就是为了让那件事
        不可能再发生，而不是为了少写两行 SQL。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product (category_id, name, cover, description, spec_schema, status)
        VALUES (#{categoryId}, #{name}, #{cover}, #{description}, #{specSchema}, #{status})
    </insert>

    <!--
      根据 id 更新。

      <set> 标签的两个作用：
        1. 自动去掉最后一个多余的逗号（否则 SQL 语法错误）
        2. 内部全为空时不生成 SET 关键字

      每个字段都包在 <if> 里，实现「只更新传了值的字段」。
      这样同一个方法既能做全量更新，也能做局部更新。

      注意 update_time 不用手动更新 —— 建表时写了
      ON UPDATE CURRENT_TIMESTAMP，MySQL 会自动维护。
    -->
    <update id="updateById">
        UPDATE product
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="name != null">name = #{name},</if>
            <!--
              ★★ 里程碑 15 阶段 6：price / stock 两个 <if> 从这里删掉了。

              它们原来表达的是「只改价格的时候别碰别的字段」。
              这个语义现在**整件事搬去了 product_sku** ——
              改价 = 改 SKU 行的 price，走的是一条完全不同的语句
              （ProductSkuMapper 里那条窄 UPDATE）。

              ⚠️ 所以「改商品」这个动作现在是【两条路径】：
                - 改名字/分类/描述 → 这张表
                - 改价格/库存      → product_sku 表
              两者由同一次 PUT /admin/products/{id} 驱动、在同一个事务里，
              但**它们不再是同一个 UPDATE 语句**。
              加新字段时要想清楚它属于哪一边：属于「商品」的住这里，
              属于「某个规格」的住 product_sku。
            -->
            <if test="cover != null">cover = #{cover},</if>
            <if test="description != null">description = #{description},</if>
            <!--
              ★ 里程碑 15 加的。注意它和上面那些字段【有一处不同】：
                description 传 null 表示「不改」，而 spec_schema 传 null
                表示「这次不碰规格定义」，它【不是】「无规格」。

                「无规格」必须显式传字符串 "[]"（SpecJson.EMPTY）。
                如果让 null 也表示「无规格」，那么「不改规格定义」
                和「清空规格定义」就成了同一件事 ——
                一个只想改价格的 PUT 会顺手把商品的规格抹平。
                这正是 images 那个字段用 tri-state 表达的同一件事，
                结论也一致：字段缺席 = 不修改。
            -->
            <if test="specSchema != null">spec_schema = #{specSchema},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 物理删除。返回的 int 是影响行数，0 表示这个 id 不存在 -->
    <delete id="deleteById">
        DELETE FROM product
        WHERE id = #{id}
    </delete>

    <!--
      ==========================================================================
      以下是用户端（商城前台）的查询
      ==========================================================================
    -->

    <!--
      用户端的查询条件。

      ★ 和管理端的 queryCondition 最关键的区别：这里把 status = 1
        【写死在 SQL 里】，不是靠 <if> 判断参数。

        也就是说：无论 Service 传什么、无论前端怎么构造 URL，
        这条 SQL 都只会返回上架商品。想绕过它只有一个办法 ——
        改这个文件。而改文件是会被 code review 看到的。

        注意 <where> 标签在这里的作用：因为第一行 p.status = 1 是恒成立的，
        所以后面那些 <if> 里就可以安心用 AND 开头，不用担心变成
        "WHERE AND p.name LIKE ..." 这种语法错误
    -->
    <sql id="shopQueryCondition">
        <where>
            p.status = 1
            <if test="keyword != null">
                AND p.name LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="categoryId != null">
                AND p.category_id = #{categoryId}
            </if>
        </where>
    </sql>

    <!--
      ★★ 动态排序 —— 本项目唯一一处「不能用 #{}」的地方，值得仔细看。

      问题：ORDER BY 后面跟的是【列名】，而 #{} 生成的是预编译占位符 ?。
           预编译只能替换「值」，替换不了「标识符」：
             SELECT * FROM t WHERE price = ?       ← 合法
             SELECT * FROM t ORDER BY ?            ← 语法错误！
           所以动态排序没法用 #{}，只能用 ${} 拼字符串。

      而 ${} 是 SQL 注入的入口。如果写成 ORDER BY ${sort}，
      前端传 sort = "id; DROP TABLE product 然后再加个 SQL 注释符" 就可能把表删了。

      （顺带一提：写这段注释时我把那个注释符原样打了出来，
        结果 MyBatis 启动直接报「注释中不允许出现字符串」并起不来 ——
        XML 注释里是不允许出现连续两个减号的，这是 XML 规范。
        而这个错误 mvn compile 是【查不出来】的，因为 XML 映射文件
        要等运行时才被 MyBatis 解析。所以改完 mapper XML 一定要真启动一次。）

      常见的解决方式是「在 Java 层做白名单，只允许几个固定的列名通过」，
      然后拼进 ${}。但那种做法仍然有一个隐患：
      白名单一旦写岔（比如用了 startsWith 判断），
      或者将来有人为了「支持按销量排序」直接放开了限制，
      注入就又回来了。

      ★ 这里用的是更彻底的做法：**根本不用 ${}**。
        用 <choose> 把每个允许的排序方式写成一个完整的分支，
        ORDER BY 后面的内容是【写死在 XML 里的字面量】。
        前端传来的 sort 值只参与 <when test="..."> 的【比较】，
        永远没有机会变成 SQL 的一部分。

      这样即使 DTO 里的白名单校验被误删了，注入也依然不可能 ——
      这是「纵深防御」：两层防护，各自独立生效。
      第二层（<choose>）不依赖第一层（Java 白名单）是否正确。

      代价是每加一种排序要改两个地方（DTO 常量 + 这里的 <when>）。
      对于一个排序选项总共就三四种的场景，这个代价完全可以接受。
    -->
    <sql id="shopOrderBy">
        <choose>
            <when test="sort == 'price_asc'">
                ORDER BY a.min_price ASC, p.id DESC
            </when>
            <when test="sort == 'price_desc'">
                ORDER BY a.min_price DESC, p.id DESC
            </when>
            <otherwise>
                ORDER BY p.id DESC
            </otherwise>
        </choose>
    </sql>

    <!--
      ★★ 里程碑 15 阶段 3：这里的 p.price 换成了 a.min_price，两处都换。

      ★ 为什么必须换，而不是「换个表而已」：
        **排序用的价格必须等于列表上显示的那个价格。**
        列表上现在显示的是起售价（sku 的 MIN(price)），
        如果排序还按 product.price 排，用户在「价格从低到高」下会看到
        [¥100, ¥80, ¥50] 这样一个明显没排序的列表 ——
        看起来像分页坏了或者排序没生效，而两处都不会报错。

      ⚠️ 两个值在阶段 1~5 期间【恰好相等】（product.price 那时是派生汇总副本），
        所以这个 bug 在那时看不出来 —— 而这正是最危险的一类地方：
        **一处写对了一处没写对、但结果碰巧一样**，谁来 review 都看不出问题。
        ★ 阶段 6 跑完 migration-13b 之后，product.price 这一列已经【不存在】了，
          于是「改回去」从「静默的错」变成了「当场 Unknown column」——
          这不是顺带的好处，这是删列这件事值不值得做的主要判据之一。
          （另一处同样的理由见 test-sku.py A 组那条静态断言。）
    -->

    <!--
      ★ 上面每个分支都带了 "p.id DESC" 作为「第二排序键」，这不是多余的。

        如果只写 ORDER BY p.price ASC，价格相同的商品之间顺序是【不确定的】——
        MySQL 不保证两次查询返回同样的顺序。

        这在分页时会造成真实的 bug：
          第 1 页查到 [A(10元), B(10元)]，第 2 页查到 [A(10元), C(10元)]
          → A 出现了两次，而 D 被跳过了

        用户看到的现象是「翻页时有的商品重复出现，有的从来没见过」。
        这类问题在数据量小的时候几乎不会出现，等数据库大了才浮现，
        而且很难复现。

        ★ 记住这条规则：**只要用 LIMIT 分页，ORDER BY 就必须包含
          一个唯一字段（通常是主键）作为最后的排序键。**
          哪怕你前面已经按价格排好了。
    -->

    <!--
      用户端商品列表。

      注意 SELECT 的列少了一个 description —— 列表不查长文本，
      详见 ShopProductVO 的类注释。这行 SQL 就是那个决定的落地处。
    -->
    <select id="selectShopPage" resultType="ShopProductVO">
        SELECT
            p.id,
            p.category_id,
            p.name,
            p.cover,
            c.name AS category_name,
            a.min_price                AS min_price,
            COALESCE(a.total_stock, 0) AS total_stock,
            COALESCE(a.sku_count, 0)   AS sku_count,
            <!--
              ★ 只在【恰好一个规格】时才给出 skuId，多规格时是 NULL。

              为什么不一并给一个「随便挑的默认规格」？因为那会是一个
              【看起来像答案的假答案】：用户点「加入购物车」，
              系统替他选了一个他根本没选的规格（可能是最贵的那档），
              而页面上没有任何地方说过这件事。

              ★ 一个回答不了的问题不应该有一个假答案 ——
                前端拿到 null 会老老实实把按钮改成「选规格」跳详情页。

              ⚠️ non_null 让这个 key 在多规格商品上【整个消失】，
                而不是出现一个 null。前端判断要用 falsy（!p.defaultSkuId），
                不要用「非要等于 null」。
            -->
            CASE WHEN a.sku_count = 1 THEN a.only_sku_id END AS default_sku_id
        FROM product p
                 LEFT JOIN category c ON c.id = p.category_id
                 <include refid="skuAggregate"/>
        <include refid="shopQueryCondition"/>
        <include refid="shopOrderBy"/>
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 用户端列表总数。WHERE 用同一个 include，JOIN 去掉（总数不需要分类名） -->
    <select id="countShopByQuery" resultType="long">
        SELECT COUNT(*)
        FROM product p
        <include refid="shopQueryCondition"/>
    </select>

    <!--
      用户端商品详情。

      WHERE 里同时带了 id 和 status = 1 ——
      所以「不存在的 id」和「已下架的 id」会得到同一个结果（查不到），
      Service 因此也没法区分，只能给出同一句「商品不存在」。
      这正是我们要的效果，理由见 ProductMapper.selectShopById 的注释。
    -->
    <select id="selectShopById" resultType="ShopProductDetailVO">
        SELECT
            p.id,
            p.category_id,
            p.name,
            p.cover,
            p.description,
            c.name AS category_name
        FROM product p
                 LEFT JOIN category c ON c.id = p.category_id
        WHERE p.id = #{id}
          AND p.status = 1
    </select>

    <!--
      批量查询上架商品，给购物车用。

      <foreach> 是 MyBatis 处理「集合参数」的标签，几个属性都要知道：
        collection="ids"  要遍历的集合。参数用了 @Param("ids")，
                          所以这里写 ids；不用 @Param 的话得写 collection/list
        item="pid"        每次遍历的元素变量名，下面 #{pid} 就是引用它
        open="(" close=")" 整个循环外面包什么 —— 拼出 IN ( ... )
        separator=","     元素之间用什么隔开

      最终生成：WHERE p.id IN ( ? , ? , ? ) AND p.status = 1

      ★ 注意即使写成 IN ( #{...} ) 用的也是 #{}，不是 ${}，
        所以依然是预编译占位符，SQL 注入进不来。
        很多人以为「IN 要拼字符串所以只能用 ${}」—— 那是错的，
        MyBatis 的 <foreach> 会把每个元素都变成独立的 ? 占位符。

      ★ 为什么不带 ORDER BY？
        顺序由调用方在 Java 里决定（购物车按加入时间或 id 排），
        SQL 只管把数据捞出来。让 SQL 少做点事、多留点在 Java 里可控，
        这类「展现顺序」的问题尤其如此 —— 它经常变，改 SQL 比改 Java 麻烦。
    -->
    <select id="selectShopByIds" resultType="ShopProductVO">
        SELECT
            p.id,
            p.category_id,
            p.name,
            p.cover,
            c.name AS category_name
        FROM product p
                 LEFT JOIN category c ON c.id = p.category_id
        WHERE p.status = 1
          AND p.id IN
        <foreach collection="ids" item="pid" open="(" close=")" separator=",">
            #{pid}
        </foreach>
    </select>

    <!--
      ★ 里程碑 15 阶段 4：decreaseStock / increaseStock 两条 <update> 【已删除】，
        连同上面那两大段注释一起搬去了 ProductSkuMapper.xml。
        理由见 ProductMapper.java 末尾那段。

      ⚠️ 注意 selectShopByIds 上面这段注释【原样留着】—— 它讲的是
        <foreach> 的写法和 status = 1 的归属，和库存没关系。
        阶段 3 的 ShopSkuServiceImpl 还要靠这条 SQL 判断「这件商品可不可买」。
    -->

</mapper>
