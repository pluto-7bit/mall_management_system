<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      继承 Spring Boot 的父 POM。
      它的作用是「统一管理依赖版本」：下面大部分依赖都不用写 <version>，
      由父 POM 决定一个互相兼容的版本组合，避免你自己拼版本拼出冲突。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>mall-server</artifactId>
    <version>1.0.0</version>
    <name>mall-server</name>
    <description>商城管理系统 - 后端服务</description>

    <properties>
        <java.version>21</java.version>
        <!-- MyBatis 不在 Spring Boot 父 POM 的管理范围内，版本要自己写 -->
        <mybatis-starter.version>3.0.5</mybatis-starter.version>
        <!-- JWT 库同理，也要自己写版本 -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- Web：内嵌 Tomcat + Spring MVC，提供 REST 接口能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @Min 这些注解靠它生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis：负责 Java 对象 <-> SQL 之间的映射 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-starter.version}</version>
        </dependency>

        <!-- MySQL 驱动，只在运行时需要 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          ==================================================================
           Redis：购物车的存储（里程碑 7）

           引入它会有三个东西被自动装配出来，认识一下：
             RedisConnectionFactory   连接工厂，管连接池
             RedisTemplate<K,V>       通用模板，key 和 value 都是 Java 对象，
                                      默认用 JDK 序列化 —— 存进去的东西
                                      用 redis-cli 看是一堆乱码
             StringRedisTemplate      RedisTemplate<String,String> 的
                                      特化版本，key 和 value 都是人可读的
                                      字符串（内部用 StringRedisSerializer）

           ★ 我们用 StringRedisTemplate，不用 RedisTemplate。
             理由是调试体验：购物车数据用 redis-cli 直接 `HGETALL cart:1`
             就能看懂，这对学习项目极其重要 ——
             你能亲眼看到「代码点一下，Redis 里真的多了一条」。
             用默认的 RedisTemplate 的话，你会看到
             "\xac\xed\x00\x05t\x00\x0b..." 这种东西，什么也验证不了。

             代价是数字要自己转成字符串再转回来（见 CartServiceImpl）。
             这个代价很小，而且逼着你时刻清楚「Redis 里存的到底是什么」。
          ==================================================================
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          ★ 这一条不加，项目启动时会报
            "NoClassDefFoundError: org/apache/commons/pool2/impl/GenericObjectPool"

          为什么？spring-boot-starter-data-redis 内部的连接池
          （Lettuce）需要一个「对象池」实现，而对象池本身是个可选依赖，
          不算在 starter 里。Spring Boot 的自动配置发现
          classpath 上有 commons-pool2 才会启用连接池。

          不加也能跑（Lettuce 不用池也能工作），但生产环境必须要有：
          没有连接池的话每次操作可能新建一个连接，
          高并发下会把 Redis 的连接数打满。

          ★ 这个坑的典型特征是「编译期一点问题没有，启动就炸」——
            因为它是一个运行期才加载的类。凡是看到 NoClassDefFoundError
            而不是 ClassNotFoundException，就往「运行时依赖缺失」方向查。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!--
          BCrypt 密码加密。
          这里刻意只引 spring-security-crypto（一个纯工具库），
          而不是 spring-boot-starter-security —— 后者会自动接管所有请求、
          生成默认登录页，对现在的我们来说是干扰。我们只要加密能力。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
          ==================================================================
           JWT：登录凭证的载体。这里要引三个 artifact，别只引第一个。
          ==================================================================

          jjwt-api    编译期用。你的代码里只会出现这一包里的类
                      （Jwts、Claims、SecretKey 等）。
          jjwt-impl   运行期的真正实现，scope 必须是 runtime。
          jjwt-jackson 用 Jackson 来序列化 JWT 的 payload，也是 runtime。

          ★ 为什么 impl 和 jackson 要用 runtime scope？
          这是「面向接口编程」在依赖层面的体现：
          你写代码时只依赖 API，不依赖具体实现。
          好处是将来想换成别的 JWT 实现，改一行 pom 就行，Java 代码完全不动。
          而且 runtime scope 的包不会出现在编译期 classpath 里 ——
          相当于编译器帮你把关，防止你不小心用了实现类的内部方法。

          ★ 为什么不用 spring-boot-starter-security？
          它会自动接管所有请求、生成默认登录页、强加一套过滤器链。
          对学习项目来说，那些默认行为是个黑盒，出了问题很难查。
          我们只想要「密码加密」和「自己写一个拦截器」这两件事，
          所以引 spring-security-crypto（已有）和 jjwt 就够了。
          ==================================================================
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok：用 @Data 等注解自动生成 getter/setter，少写一堆样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：JUnit 5 + Mockito + Spring 测试支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 让 mvn package 能打出可直接 java -jar 运行的 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 只在编译期起作用，没必要打进最终产物 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
