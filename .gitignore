# ============================================================================
#  .gitignore —— 什么不进版本库，以及为什么
#
#  判据只有一条：**这个文件是「我写的东西」，还是「跑出来的东西 / 别人的东西」？**
#  前者进版本库，后者不进。
#
#  ⚠️ 这份文件只影响「以后的 git 会不会跟踪它」，**不会删除磁盘上的任何文件**。
#     所以下面被忽略的东西现在都还在原地，需要时照常能用。
# ============================================================================

# --- 依赖与构建产物：体积大、可重现、跑一条命令就能重新生成 ----------------
node_modules/
dist/
target/

# --- Python 的字节码缓存 ----------------------------------------------------
__pycache__/
*.pyc

# --- 运行时产物：后台上传的图片 ---------------------------------------------
#  ⚠️ 这里面的文件是**用户自己传的**，而且文件名是 UUID（不可重现）。
#     它们进版本库等于把运行时的二进制塞进历史，且每次跑测试都会多几个。
#     注意：mall-shop/public/images/*.svg 那些**不在此列** —— 它们是
#     gen-shop-assets.py 生成的商品图，是前端真正依赖的静态资源，属于
#     「我写的东西」，要进版本库。两者是两条独立的通道，别混。
mall-server/uploads/

# --- 数据库转储：含用户自己录入的真实数据 -----------------------------------
#  ★★ 这一条是整份文件里最要紧的一条。
#     backup-mall-*.sql 是 mall 库的 mysqldump，backup-mall-sql-file-*.sql
#     是 mall.sql 的文件备份 —— 两者都含有用户手输的商品、会员、订单数据。
#     它们一旦进了版本库，就再也删不干净（会留在历史里），
#     而这个仓库将来可能会被推到远端。**绝不能提交。**
sql/backup-*.sql

# --- 测试脚本的输出日志：转瞬即逝，且和脚本当前的断言数对不上 --------------
#  ⚠️ 它们记的通过数是**当时**的，脚本改过之后就是过期的数字。
#     留着容易被当成「当前状态」引用（README 里明确不写「恰好 N 项」，
#     理由和这条是同一个）。
sql/*.out

# --- 手工调试留下的请求体样本：没有任何脚本引用它们 -------------------------
#  ⚠️ 里程碑 2/3 时期用 curl -d @文件 手测时写下的，现在全项目 grep 不到
#     任何一行代码读它们。一个**没有读者**的文件和没有读者的字段是同一件事，
#     所以不放进版本库 —— 但也**不删**（「收尾」不等于「删东西」）。
sql/test-*.json

# --- SQL 生成物：有专门的脚本负责生成它 -------------------------------------
#  gen-shop-assets.py 写出它 → sync-mall-seed.py 读它并把 seed 段替换进
#  mall.sql。替换完成后 mall.sql 里已经是最终内容，这个中间文件就只剩下
#  「和 mall.sql 里那份会分岔的第二份副本」这一个身份。要重建就跑一遍
#  gen-shop-assets.py。
sql/generated-mall-seed.sql

# --- 工具脚本的临时夹具 -----------------------------------------------------
tools/.fixture-pay.json

# --- 编辑器与本地工具的配置：因人而异，不该强加给协作者 --------------------
.vscode/
.claude/
